# ===== Copy this file to .env and fill in real values. NEVER commit .env =====

# --- Supabase (Postgres) ---
# Runtime connection: the pooler in SESSION mode (port 5432). For a long-running server it costs
# about one network round trip per query; transaction mode (6543, ?pgbouncer=true) costs ~5,
# which is seconds per page when the database is far away. connection_limit keeps the app
# inside the free pooler limits. (Serverless hosting would need 6543 instead.)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?connection_limit=5"
# Direct / session-pooler connection (port 5432) - used ONLY by prisma migrate
# If direct (db.[ref].supabase.co) fails with P1001, use the Session pooler string instead (IPv4-friendly)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Backend ---
PORT=5000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"
# bcrypt cost factor (optional, defaults to 12)
BCRYPT_ROUNDS=12
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS="http://localhost:3000"
# Cookie Domain for the session cookie. Leave EMPTY for localhost.
# In production set it to the shared parent domain so app. and api. share the cookie,
# e.g. ".example.com"
COOKIE_DOMAIN=""

# --- Database seed (npm run db:seed) - the first ADMIN account ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-min-8-chars"

# --- Demo data (npm run db:seed:demo) - optional, for demos and local development only ---
# The organizer account that owns the four sample events. Never run this in production.
SEED_DEMO_ORGANIZER_EMAIL="organizer.demo@example.com"
SEED_DEMO_ORGANIZER_PASSWORD="change-me-min-8-chars"

# --- Frontend --- lives in frontend/.env.local (see frontend/.env.example), not here.

# --- AI chatbot (FR-23) - only Role 3 needs this ---
# Groq (groq.com - not xAI's "Grok"), per Leader decision. See CLAUDE.md and
# backend/src/modules/chatbot/API.md. Get a key at https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# --- Analytics service (FR-20 attendance predictions) - optional ---
# Where the Python service in /analytics listens. Locally: http://localhost:8000
# With docker compose: http://analytics:8000 . Leave empty to skip predictions.
ANALYTICS_URL="http://localhost:8000"
# Shared secret with the analytics service (set the same value there). Needed only when that
# service is reachable from the internet, e.g. on a free Render plan. Leave empty locally.
ANALYTICS_TOKEN=""
