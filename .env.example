# ===== Copy this file to .env and fill in real values. NEVER commit .env =====

# --- Supabase (Postgres) ---
# Pooled connection (port 6543) - used by the app at runtime
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct / session-pooler connection (port 5432) - used ONLY by prisma migrate
# If direct (db.[ref].supabase.co) fails with P1001, use the Session pooler string instead (IPv4-friendly)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Backend ---
PORT=5000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS="http://localhost:3000"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:5000"

# --- AI chatbot (FR-23) - only Role 3 needs this ---
ANTHROPIC_API_KEY=""
