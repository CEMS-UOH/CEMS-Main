// =====================================================================
// SCEMS database schema - 8 entities
// OWNER: Role 2 (Backend + Database). Everyone else: ask Role 2 to change it.
// After any change run:  npx prisma migrate dev --name <short_description>
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  // One SQL query per findMany, with related rows (category, venue, organizer, counts) joined
  // in, instead of one extra query per relation. The database is far from the API (Frankfurt),
  // so every avoided round trip is felt on every page. No effect on the schema or migrations.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
}

enum NotificationType {
  BOOKING_CONFIRMATION
  CAPACITY_FULL
  BROADCAST
  SYSTEM
  // FR-17: tells the organizer the admin's decision on their event request.
  EVENT_APPROVED
  EVENT_REJECTED
  // Sent the day before and the hour before an event the attendee holds a seat for.
  EVENT_REMINDER
  // A seat freed up and went to the first person on the waitlist.
  WAITLIST_PROMOTED
}

// 1) Users - attendees (students, faculty, visitors), organizers, admins
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole @default(ATTENDEE)
  // Contact details an Organizer gives when registering, so the Admin reviewing an event
  // request knows who is asking. Null for Attendees and for accounts an Admin created.
  // Shown to Admins only - never part of anything an Attendee can read.
  phone        String?
  organization String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizedEvents Event[]         @relation("EventOrganizer")
  registrations   Registration[]
  feedbacks       Feedback[]
  notifications   Notification[]
  chatSessions    ChatSession[]
  waitlistEntries WaitlistEntry[]
  favorites       Favorite[]

  @@map("users")
}

// 2) Venue - halls / rooms where events happen
model Venue {
  id       String  @id @default(uuid())
  name     String
  building String?
  location String?
  capacity Int

  events Event[]

  @@map("venues")
}

// 3) Category - workshop, seminar, competition, ...
model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  events Event[]

  @@map("categories")
}

// 4) Event
model Event {
  id          String      @id @default(uuid())
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  status      EventStatus @default(PENDING)
  imageUrl    String?
  attachments String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizerId String
  organizer   User     @relation("EventOrganizer", fields: [organizerId], references: [id])
  venueId     String?
  venue       Venue?   @relation(fields: [venueId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  registrations Registration[]
  feedbacks     Feedback[]
  waitlist      WaitlistEntry[]
  favoritedBy   Favorite[]

  @@index([startsAt])
  @@index([status])
  @@map("events")
}

// 5) Registration - a seat booking, with its QR code and check-in time
model Registration {
  id                 String             @id @default(uuid())
  status             RegistrationStatus @default(CONFIRMED)
  qrCode             String             @unique
  checkedInAt        DateTime?
  createdAt          DateTime           @default(now())
  // When the "tomorrow" and "in an hour" reminders went out, so each is sent once.
  dayReminderSentAt  DateTime?
  hourReminderSentAt DateTime?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([userId])
  @@map("registrations")
}

// 6) Feedback - rating after an event
model Feedback {
  id        String   @id @default(uuid())
  rating    Int // 1..5 (validate in the API)
  comment   String?
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("feedbacks")
}

// 7) Notification - one row per recipient (a broadcast creates one row per user)
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// 8) ChatSession - AI assistant conversation history (FR-23)
model ChatSession {
  id        String   @id @default(uuid())
  messages  Json     @default("[]") // [{ role: "user"|"assistant", content: "..." }]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("chat_sessions")
}

// 9) WaitlistEntry - an attendee waiting for a seat at a full event. The earliest entry gets
//    the next freed seat automatically (see attendee/waitlist.service.js).
model WaitlistEntry {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, createdAt])
  @@map("waitlist_entries")
}

// 10) Favorite - an event an attendee saved to come back to.
model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("favorites")
}
