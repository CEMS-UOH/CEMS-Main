# Next.js only reads .env files from THIS folder. Copy to .env.local

# Where the Express API runs. The site passes every /api/* request on to it (next.config.ts),
# so the browser only ever talks to this site. On Vercel: the backend's public URL.
BACKEND_URL=http://localhost:5000

# Leave unset: API calls then go through the site's own address (above). Only set it to call
# an API on another address directly, which needs a shared cookie domain (see docs/DEPLOY.md).
# NEXT_PUBLIC_API_URL=
